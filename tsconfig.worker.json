{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["worker/**/*.ts", "worker-configuration.d.ts"],
  "exclude": ["worker/**/*.test.ts", "worker/test-helpers/**"]
}
