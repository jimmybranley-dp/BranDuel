{
  "name": "branduel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && node scripts/run-vite.mjs build --config vite.config.ts",
    "build:bundle": "node scripts/run-vite.mjs build --config vite.config.ts",
    "check": "tsc -b",
    "lint": "eslint . --max-warnings=0 && npm run check:architecture",
    "format:check": "prettier --check eslint.config.mjs scripts/check-architecture.mjs scripts/architecture-guardrails.test.mjs scripts/observability-config.test.mjs scripts/isolated-wrangler-config.mjs scripts/run-event-rehearsal.mjs scripts/run-browser-tests.mjs scripts/browser-test-server.mjs scripts/run-vitest.mjs scripts/run-vite.mjs scripts/verify.mjs scripts/verification-plan.mjs scripts/verification-plan.test.mjs scripts/browser-test-plan.mjs scripts/browser-test-plan.test.mjs scripts/wrangler-types.mjs scripts/wrangler-types.test.mjs scripts/docs-check.mjs scripts/docs-check.test.mjs scripts/execution-plan-check.mjs scripts/execution-plan-check.test.mjs scripts/check-artifact-safety.mjs scripts/artifact-safety.test.mjs scripts/fixtures/invalid-ui-bypass.tsx package.json tsconfig.json tsconfig.app.json tsconfig.node.json tsconfig.worker.json docs/**/*.md worker/observability.ts src/product-contract.test.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:architecture": "node --test scripts/architecture-guardrails.test.mjs",
    "test:observability": "node --test scripts/observability-config.test.mjs",
    "test:types": "node --test scripts/wrangler-types.test.mjs",
    "test:docs": "node --test scripts/docs-check.test.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "test:plans": "node --test scripts/execution-plan-check.test.mjs",
    "execution-plans:check": "node scripts/execution-plan-check.mjs",
    "test:artifacts": "node --test scripts/artifact-safety.test.mjs",
    "types": "node scripts/wrangler-types.mjs generate",
    "types:check": "node scripts/wrangler-types.mjs check",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "verify:stage": "node scripts/verify.mjs --stage",
    "verify:from": "node scripts/verify.mjs --from",
    "check:artifacts": "node scripts/check-artifact-safety.mjs",
    "setup:passcodes": "node scripts/setup-passcodes.mjs",
    "test:event": "node scripts/run-event-rehearsal.mjs",
    "diagnostics:local": "node scripts/diagnostic-summary.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:browser:critical": "node scripts/run-browser-tests.mjs --suite critical",
    "test:verification-plan": "node --test scripts/verification-plan.test.mjs",
    "test:browser-plan": "node --test scripts/browser-test-plan.test.mjs",
    "sim:economy": "vitest run --config vite.config.ts src/economy-sim.test.ts",
    "sim:heat": "node scripts/run-vitest.mjs src/heat-sim.test.ts",
    "sim:economy:fast": "vitest run --config vite.config.ts src/economy-sim.test.ts",
    "sim:economy:stress": "set ECONOMY_NIGHTS=500&& set ECONOMY_ROUNDS=12&& set ECONOMY_TIMEOUT_MS=30000&& vitest run --config vite.config.ts src/economy-sim.test.ts",
    "sim:economy:replay": "vitest run --config vite.config.ts src/economy-sim.test.ts",
    "preview": "vite preview",
    "test": "node scripts/run-vitest.mjs",
    "db:migrate:local": "wrangler d1 migrations apply branduel-db --local",
    "db:migrate:staging": "node scripts/cloudflare-operation.mjs migrate staging",
    "db:migrate:production": "node scripts/cloudflare-operation.mjs plan production migrate",
    "deploy:staging": "node scripts/cloudflare-operation.mjs deploy staging",
    "deploy:production": "node scripts/cloudflare-operation.mjs plan production deploy",
    "secret:put:staging": "node scripts/cloudflare-operation.mjs secret-put staging",
    "secret:put:production": "node scripts/cloudflare-operation.mjs plan production secret-put"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.6",
    "@fontsource/barlow-condensed": "^5.2.6",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^14.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "wrangler": "4.134.0"
  }
}
