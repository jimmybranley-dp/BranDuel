{
  "name": "branduel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "check": "tsc -b",
    "setup:passcodes": "node scripts/setup-passcodes.mjs",
    "test:event": "node scripts/event-smoke.mjs",
    "test:browser": "playwright test",
    "sim:economy": "vitest run --config vite.config.ts src/economy-sim.test.ts",
    "sim:economy:fast": "vitest run --config vite.config.ts src/economy-sim.test.ts",
    "sim:economy:stress": "set ECONOMY_NIGHTS=500&& set ECONOMY_ROUNDS=12&& set ECONOMY_TIMEOUT_MS=30000&& vitest run --config vite.config.ts src/economy-sim.test.ts",
    "sim:economy:replay": "vitest run --config vite.config.ts src/economy-sim.test.ts",
    "preview": "vite preview",
    "test": "vitest run --config vite.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply branduel-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply branduel-db --remote",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.6",
    "@fontsource/barlow-condensed": "^5.2.6",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.30.0"
  }
}
