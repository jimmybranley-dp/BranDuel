{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "branduel",
  "compatibility_date": "2026-08-15",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "secrets": {
    "required": ["PLAYER_PASSCODES"]
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "branduel-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "branduel-staging",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "branduel2.jimmybranley.com",
          "custom_domain": true
        }
      ],
      "observability": {
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": false,
          "persist": true
        }
      },
      "secrets": {
        "required": ["PLAYER_PASSCODES"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "branduel-staging",
          "database_id": "92d0a87d-d641-472f-ad1c-07210e38096a",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "branduel-production",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "branduel.jimmybranley.com",
          "custom_domain": true
        }
      ],
      "observability": {
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": false,
          "persist": true
        }
      },
      "secrets": {
        "required": ["PLAYER_PASSCODES"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "branduel-production",
          "database_id": "0f145357-054d-40aa-875f-16f270314186",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
